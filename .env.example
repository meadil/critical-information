# --- Critical Information: environment template ---
# Copy to .env and fill in. NEVER commit the real .env.
#
# These names match what the scripts actually read. Checked against:
#   scripts/notion_pull.py, scripts/notion_sync.py, scripts/notion_setup.py,
#   scripts/store_batch.py, scripts/store_claim.py

# Supabase - where approved claims are stored
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Notion - the human review inbox
NOTION_API_KEY=secret_your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Optional: the Notion page that holds the database, used by notion_setup.py
NOTION_PARENT_PAGE_ID=

# Local API server port (see the run command at the top of toolbox_api.py)
# uvicorn toolbox_api:app --port 8000